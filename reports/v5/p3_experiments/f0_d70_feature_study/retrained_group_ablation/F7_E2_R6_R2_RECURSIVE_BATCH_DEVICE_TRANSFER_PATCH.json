  "corrected_move_batch_source": "def move_batch(batch, device):\n    # P3 batches contain tensors plus provenance/metadata lists.\n    def _f7_move_value(_value):\n        if isinstance(_value, torch.Tensor):\n            return _value.to(device, non_blocking=device.type == 'cuda')\n        if isinstance(_value, dict):\n            return {\n                _key: _f7_move_value(_child)\n                for _key, _child in _value.items()\n            }\n        if isinstance(_value, list):\n            return [_f7_move_value(_child) for _child in _value]\n        if isinstance(_value, tuple):\n            return tuple(\n                _f7_move_value(_child) for _child in _value\n            )\n        return _value\n\n    return _f7_move_value(batch)",
